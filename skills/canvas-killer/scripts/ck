#!/usr/bin/env bash
# canvas-killer launcher: keeps a private Python environment under the
# canvas-killer home (re-installed when requirements.txt changes) and runs ck.py in it.
# Works with bash on macOS, Linux and Windows (Git Bash, which Claude Code uses there).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CK_HOME="${CANVAS_KILLER_HOME:-$HOME/.canvas-killer}"
VENV="$CK_HOME/venv"
STAMP="$VENV/.requirements"

venv_python() {
  if [ -x "$VENV/bin/python" ]; then echo "$VENV/bin/python"
  elif [ -x "$VENV/Scripts/python.exe" ]; then echo "$VENV/Scripts/python.exe"
  fi
}

if [ -z "$(venv_python)" ] || ! cmp -s "$HERE/requirements.txt" "$STAMP"; then
  PY=""
  for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
      PY="$candidate"
      break
    fi
  done
  if [ -z "$PY" ]; then
    echo "canvas-killer needs Python 3.9 or newer: install it from https://www.python.org/downloads/" >&2
    exit 1
  fi
  mkdir -p "$CK_HOME" && chmod 700 "$CK_HOME"
  echo "Setting up the canvas-killer Python environment in $VENV (first run takes a minute) ..." >&2
  [ -n "$(venv_python)" ] || "$PY" -m venv "$VENV"
  "$(venv_python)" -m pip install --quiet --disable-pip-version-check -r "$HERE/requirements.txt" >&2
  cp "$HERE/requirements.txt" "$STAMP"
fi
exec "$(venv_python)" "$HERE/ck.py" "$@"
